package components

import (
	"fmt"

	"github.com/ChouChiu/neptune/internal/model"
)

// ReportCards renders a list of report cards as an HTML fragment for HTMX.
templ ReportCards(reports []model.Report) {
	if len(reports) == 0 {
		@EmptyState("📭", "暂无举报记录")
	} else {
		<div class="flex flex-col gap-3">
			for _, r := range reports {
				@reportCard(r)
			}
		</div>
	}
}

templ reportCard(r model.Report) {
	<div class="island bg-neutral-950 border border-white/10 rounded-2xl p-5 hover:border-white/20 transition-colors">
		<div class="flex items-start justify-between gap-3">
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2 mb-1.5">
					<span class="text-xs font-mono text-neutral-500">#{ fmt.Sprintf("%d", r.ID) }</span>
					@StatusBadge(r.Status)
					<span class="text-xs text-neutral-600">{ FormatTimeAgo(r.CreatedAt) }</span>
				</div>
				<div class="text-sm text-white mb-1.5">{ r.Content }</div>
				<div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-neutral-500">
					<span>群组: <span class="font-mono">{ fmt.Sprintf("%d", r.GroupID) }</span></span>
					<span>举报人: <span class="font-mono">{ fmt.Sprintf("%d", r.ReporterID) }</span></span>
					<span>被举报人: <span class="font-mono">{ fmt.Sprintf("%d", r.ReportedUserID) }</span></span>
				</div>
				if r.ReportedMessageText != "" {
					<div class="mt-3 p-3 bg-white/[0.03] rounded-xl border border-white/5 text-xs text-neutral-400 break-words">
						<span class="text-neutral-600 text-[10px] uppercase tracking-wider">被举报消息</span><br/>
						{ r.ReportedMessageText }
					</div>
				}
			</div>
			if r.Status == "pending" {
				<div class="flex gap-1.5 shrink-0">
					<button
						class="px-3 py-1.5 text-xs rounded-lg border border-white/15 text-neutral-400 hover:text-green-400 hover:border-green-400/50 transition-colors resolve-btn"
						data-id={ fmt.Sprintf("%d", r.ID) }
						data-action="approved"
					>
						通过
					</button>
					<button
						class="px-3 py-1.5 text-xs rounded-lg border border-white/15 text-neutral-400 hover:text-red-400 hover:border-red-400/50 transition-colors resolve-btn"
						data-id={ fmt.Sprintf("%d", r.ID) }
						data-action="dismissed"
					>
						驳回
					</button>
				</div>
			}
		</div>
	</div>
}
