# Neptune 环境变量配置
# 复制本文件为 .env 并填入实际值：cp .env.example .env

# ===== 必填 =====

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=

# Bot 用户名（不含 @，用于命令注册 command@username）
BOT_USERNAME=

# Hermes Agent API Server 地址（AI 聊天功能，默认 http://127.0.0.1:8642/v1）
HERMES_API_URL=http://127.0.0.1:8642/v1

# Hermes Agent API Server 密钥（需与 Hermes 的 API_SERVER_KEY 一致）
HERMES_API_KEY=

# ===== 建议配置 =====

# GitHub Webhook 密钥（用于 Release 通知 + /set-webhook 认证）
# 生成方法：openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Release 通知频道 ID（可选，GitHub 新版本发布时通知到此频道）
RELEASE_CHANNEL_ID=

# ===== 可选 =====

# 是否复用验证码图片（true/false，默认 false）
REUSE_CAPTCHA=false

# HTTP 监听地址（默认 :8080）
LISTEN_ADDR=:8080

# SQLite 数据库路径（默认 data/neptune.db）
DB_PATH=data/neptune.db

# 数据目录（默认 ./data）
DATA_DIR=./data
