# Neptune 环境变量配置
# 复制本文件为 .env 并填入实际值：cp .env.example .env

# ===== 必填 =====

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=

# ===== 建议配置 =====

# Bot 用户名（不含 @，用于注册 command@username 与生成验证链接；留空则自动调用 getMe）
BOT_USERNAME=

# GitHub Webhook 密钥（用于 Release 通知签名校验 + /set-webhook 认证）
# 生成方法：openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Release 通知频道 ID（可选，GitHub 新版本发布时通知到此频道）
RELEASE_CHANNEL_ID=

# ===== 可选 =====

# HTTP 监听地址（默认 :8080，Docker 下无需修改）
LISTEN_ADDR=:8080

# SQLite 数据库路径（默认 data/neptune.db，Docker 下无需修改）
DB_PATH=data/neptune.db
